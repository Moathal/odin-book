{
  "dependencies": {
    "@rails/actiontext": "^7.1.3-2",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trix": "^2.1.0"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds",
    "start": "concurrently --kill-others \"bundle exec rails s -p 3000 -b '0.0.0.0'\" \"npm run build -- --watch\""
  }
}
