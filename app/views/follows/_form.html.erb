<% if current_user.following?(@user) %>
  <%= button_to 'Unfollow', user_follow_path(user_id: current_user.id, follow: { follower_id: current_user.id, followee_id: @user.id }), method: :delete, remote: true, id: 'follow_button' %>
<% else %>
  <%= button_to 'Follow', user_follows_path(user_id: current_user.id, follow: { follower_id: current_user.id, followee_id: @user.id }), method: :post, remote: true, id: 'follow_button' %>
<% end %>