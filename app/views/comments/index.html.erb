<p style="color: green"><%= notice %></p>

<h1>Comments</h1>

<div id="comments">
  <% @comments.each do |comment| %>
    <p>
      <%= render comment, post: @post %>
    </p>
    
    <div class="replies">
      <% comment.replies.each do |reply| %>
      <div>
        <%= image_tag(comment.user.avatar, alt: "#{comment.user.username}'s avatar", style: "width: 100px; height: 100px;")%>
        <h2> <%= comment.user.first_name %> <%= comment.user.last_name %> </h2>
        <p> <%= comment.text %> </p>
      </div>
      <% end %>
    <div>
      <%= render 'comments/form', parent_id: comment.id, post: @post, user: current_user, submitName: 'Reply' %>
    </div>
  <% end %>
</div>

<%= render 'comments/form', post_id: @post.id, user: current_user, parent_id: nil, submitName: 'Comment' %>
