<% @users.each do |user| %>
  <div>
    <h2><%= user.first_name %> <%= user.last_name %></h2>
    <p>Username: <%= user.username %></p>
    <% if user.avatar.present? %>
      <%= image_tag(user.avatar, alt: "#{user.username}'s avatar", style: "width: 100px; height: 100px;") %>
    <% else %>
      <p>No avatar available</p>
    <% end %>
  </div>
<%= link_to 'View Posts', user_posts_path(user) %>
<% end %>