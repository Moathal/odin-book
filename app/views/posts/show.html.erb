<p style="color: green"><%= notice %></p>

<%= render @post %>

<div>
  <%= link_to "Edit this post", edit_post_path(@post) %> |
  <%= link_to "Back to posts", posts_path %>

  <%= button_to "Destroy this post", @post, method: :delete %>
  <div class="comments">
  <%= render template: "comments/index", locals: { user: @user } %>
</div>
<%= render 'form', post: Post.new, parent_id: @post.id, submitName: 'Reply as a thread', user_id: current_user.id %>
<div class="threads">
  <%= render @threads %>
</div>
</div>
</div>
